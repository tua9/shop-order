<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product Orders</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container table-container">
    <!-- User Authentication Header Bar -->
    <div class="user-navbar">
      <% if (currentUser) { %>
        <div class="user-info-group">
          <div class="user-avatar">
            <%= (currentUser.fullName || currentUser.username || 'U').charAt(0).toUpperCase() %>
          </div>
          <div class="user-text-details">
            <span class="user-name-title"><%= currentUser.fullName || currentUser.username %></span>
            <span class="user-role-badge">Vai trò: <%= currentUser.role %></span>
          </div>
        </div>
        <div class="user-nav-actions">
          <a href="/logout" class="btn-nav-auth btn-nav-logout">Đăng xuất</a>
        </div>
      <% } else { %>
        <div class="user-info-group">
          <span style="font-size: 13.5px; color: #4b5563;">
            👋 Bạn chưa đăng nhập. Vui lòng đăng nhập để tạo đơn hàng.
          </span>
        </div>
        <div class="user-nav-actions">
          <a href="/login" class="btn-nav-auth btn-nav-login">Đăng nhập</a>
          <a href="/register" class="btn-nav-auth btn-nav-register">Đăng ký</a>
        </div>
      <% } %>
    </div>

    <h1 class="title">Product Orders</h1>

    <table class="order-table">
      <thead>
        <tr>
          <th>Customer Name</th>
          <th>Product Name</th>
          <th class="center">Quantity</th>
          <th>Order Date</th>
          <th>Total Price</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders && orders.length > 0) { %>
          <% orders.forEach(order => { %>
            <tr>
              <td><%= order.customerName %></td>
              <td><%= order.productName %></td>
              <td class="center"><%= order.quantity %></td>
              <td>
                <% 
                  const d = new Date(order.orderDate);
                  const month = String(d.getMonth() + 1).padStart(2, '0');
                  const day = String(d.getDate()).padStart(2, '0');
                  const year = d.getFullYear();
                  const formattedDate = `${month}/${day}/${year}`;
                %>
                <%= formattedDate %>
              </td>
              <td>
                <div class="action-cell">
                  <a href="/orders/update/<%= order._id %>" class="btn-update">Update</a>
                  <a href="/orders/delete/<%= order._id %>" class="btn-delete" onclick="return confirm('Are you sure you want to delete this order?');">Delete</a>
                  <span class="price-text"><%= order.totalPrice ? order.totalPrice.toLocaleString('vi-VN') : 0 %> VND</span>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="5" style="text-align: center; color: #888; padding: 24px;">No orders found. Click "Create New Order" below to add one.</td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <a href="/orders/create" class="btn-create-order">
      <%= currentUser ? 'Create New Order' : 'Create New Order (Yêu cầu đăng nhập)' %>
    </a>
  </div>
</body>
</html>
