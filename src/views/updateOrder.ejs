<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Update Order</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container form-container">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <div class="user-navbar" style="margin-bottom: 16px;">
        <div class="user-info-group">
          <div class="user-avatar" style="width: 28px; height: 28px; font-size: 12px;">
            <%= (currentUser.fullName || currentUser.username || 'U').charAt(0).toUpperCase() %>
          </div>
          <span style="font-size: 13px; color: #374151;">
            Tài khoản: <strong><%= currentUser.fullName || currentUser.username %></strong>
          </span>
        </div>
        <a href="/logout" class="btn-nav-auth btn-nav-logout" style="padding: 4px 10px; font-size: 12px;">Đăng xuất</a>
      </div>
    <% } %>

    <h1 class="title">Update Order</h1>

    <% if (error) { %>
      <div class="alert-error">
        <%= error %>
      </div>
    <% } %>

    <%
      let formattedDate = '';
      if (order && order.orderDate) {
        const d = new Date(order.orderDate);
        if (!isNaN(d.getTime())) {
          formattedDate = d.toISOString().split('T')[0];
        }
      }
    %>

    <form action="/orders/update/<%= order._id %>" method="POST">
      <div class="form-group">
        <label for="customerName">Customer Name</label>
        <input 
          type="text" 
          id="customerName" 
          name="customerName" 
          value="<%= order.customerName || '' %>"
          required
        >
      </div>

      <div class="form-group">
        <label for="productName">Product Name</label>
        <input 
          type="text" 
          id="productName" 
          name="productName" 
          value="<%= order.productName || '' %>"
          list="productList"
          autocomplete="off"
          required
        >
        <datalist id="productList">
          <% if (typeof products !== 'undefined' && products.length > 0) { %>
            <% products.forEach(p => { %>
              <option value="<%= p.productName %>"><%= p.productName %> (<%= p.unitPrice.toLocaleString('vi-VN') %> VND)</option>
            <% }); %>
          <% } %>
        </datalist>
        <div class="product-hint">
          * Note: Only products that already exist in the system can be ordered.
        </div>
      </div>

      <div class="form-group">
        <label for="quantity">Quantity</label>
        <input 
          type="number" 
          id="quantity" 
          name="quantity" 
          value="<%= order.quantity || '' %>"
          min="1"
          required
        >
      </div>

      <div class="form-group">
        <label for="orderDate">Order Date</label>
        <input 
          type="date" 
          id="orderDate" 
          name="orderDate" 
          value="<%= formattedDate %>"
          required
        >
      </div>

      <button type="submit" class="btn-primary-form">Update Order</button>
      <a href="/" class="btn-secondary-form">Go Back</a>
    </form>
  </div>
</body>
</html>
